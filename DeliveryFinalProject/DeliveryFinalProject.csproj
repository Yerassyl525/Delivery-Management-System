<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Update="SampleData/**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Native/libdelivery_native.so" Condition="'$(OS)' != 'Windows_NT' and Exists('Native/libdelivery_native.so')" CopyToOutputDirectory="PreserveNewest" Link="libdelivery_native.so" />
    <None Update="Native/delivery_native.dll" Condition="'$(OS)' == 'Windows_NT' and Exists('Native/delivery_native.dll')" CopyToOutputDirectory="PreserveNewest" Link="delivery_native.dll" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <Compile Remove="Tests/**/obj/**/*.cs" />
    <Compile Remove="Tests/**/bin/**/*.cs" />
  </ItemGroup>
</Project>
